{
  "name": "ec-automatic-news",
  "version": "0.3.4",
  "description": "EC Automatic News - escritorio portable para automatización visual de noticias",
  "author": "EC Automatic News",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "dist:portable": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "pe.ec.automaticnews",
    "productName": "EC Automatic News",
    "artifactName": "EC-Automatic-News-Portable-${version}.${ext}",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [{"from":"runtime","to":"runtime","filter":["**/*"]}],
    "extraFiles": [{"from":"DIAGNOSTICO.cmd","to":"DIAGNOSTICO.cmd"}],
    "win": { "target": ["portable"] },
    "portable": { "requestExecutionLevel": "user" }
  }
}
