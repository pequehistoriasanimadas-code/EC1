{
  "name": "ec-automatic-news",
  "version": "0.3.11",
  "description": "EC Automatic News - automatización de noticias para emisión continua",
  "main": "src/main.js",
  "author": "Carls Mayo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "dist:portable": "electron-builder --win portable dir"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "electron": "^37.2.6",
    "jsdom": "^26.1.0"
  },
  "devDependencies": {
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.carls.ecautomaticnews",
    "productName": "EC Automatic News",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ],
      "artifactName": "EC-Automatic-News-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "EC-Automatic-News-${version}-Portable.${ext}"
    }
  }
}
