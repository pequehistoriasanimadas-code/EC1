{
  "name": "ec-automatic-news",
  "version": "0.3.22",
  "description": "GEC Automatic News - escritorio portable para automatización visual de noticias",
  "author": "Carls Mayo",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/run-legacy-check.js && node scripts/check-scheduler.js && node scripts/check-tts-optimizer.js && node scripts/run-versioned-checks-0322.js && node scripts/check-0322.js",
    "dist:portable": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "fast-xml-parser": "5.10.1",
    "mammoth": "1.12.1"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "pe.ec.automaticnews",
    "productName": "EC Automatic News",
    "artifactName": "GEC-Automatic-News-Portable-${version}.${ext}",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [{"from":"runtime","to":"runtime","filter":["**/*"]}],
    "extraFiles": [{"from":"DIAGNOSTICO.cmd","to":"DIAGNOSTICO.cmd"}],
    "win": { "target": ["portable"] },
    "portable": { "requestExecutionLevel": "user" }
  }
}
